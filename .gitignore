# Local secrets - never commit
.env
.env.*

# Local Claude Code permission cache (machine/session-specific, not shared config)
.claude/settings.local.json

# Python bytecode cache
__pycache__/
*.pyc

# Local vLLM server state (node/session-specific: pid, endpoint, server log)
.vllm/

# Run outputs. Regenerable from cases/ by method/run.py, and large enough that
# committing them would dominate the repository.
method/candidates/
method/results/
method/report.md
